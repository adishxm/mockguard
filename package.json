{
  "name": "mockguard",
  "version": "0.1.0",
  "description": "Verify whether AI-generated tests protect real behavior - not just mocks",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "mockguard": "dist/src/cli/index.js"
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "pretest": "npm run build:test",
    "test": "node scripts/test-runner.js",
    "watch": "tsc -p tsconfig.test.json --watch",
    "verify:package": "node scripts/verify-package.js",
    "sbom": "node scripts/generate-sbom.js",
    "checksums": "node scripts/generate-checksums.js",
    "smoke:tarball": "node scripts/smoke-test-tarball.js",
    "release:check": "node scripts/release-check.js",
    "gemini:advisory": "npm run build:test && node dist/gemini_integration/run_advisory.js",
    "demo": "node scripts/run-demo.js",
    "demo:cli": "node scripts/run-cli-demo.js"
  },
  "dependencies": {
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.3.3"
  },
  "license": "Apache-2.0"
}
