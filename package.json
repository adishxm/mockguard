{
  "name": "mockguard",
  "version": "0.1.0",
  "description": "Verify whether AI-generated tests protect real behavior - not just mocks",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "mockguard": "dist/src/cli/index.js"
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "pretest": "npm run build:test",
    "test": "node scripts/test-runner.js",
    "watch": "tsc -p tsconfig.test.json --watch",
    "verify:package": "node scripts/verify-package.js",
    "sbom": "node scripts/generate-sbom.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "license": "Apache-2.0"
}
