{
  "name": "mockguard",
  "version": "0.1.0",
  "description": "Verify whether AI-generated tests protect real behavior - not just mocks",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mockguard": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "node --test dist/tests/**/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "license": "Apache-2.0"
}
